# Copy to .env for `npm run dev`. Never commit the real .env.
# Generate a secret with: openssl rand -base64 48
JWT_SECRET=
PORT=3000
DATABASE_PATH=data/auth.db
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=2592000
RATE_LIMIT_PER_WINDOW=20
# Comma-separated browser origins allowed by CORS (empty = no cross-origin browser access)
CORS_ORIGINS=http://localhost:5173
