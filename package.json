{
  "name": "node-auth-api",
  "version": "1.0.0",
  "description": "Authentication REST API: Express 5, JWT access tokens, rotating refresh tokens, scrypt, SQLite.",
  "main": "src/server.js",
  "scripts": {
    "test": "node --test --test-reporter=spec \"tests/**/*.test.js\"",
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "lint": "eslint . --max-warnings=0"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "supertest": "^7.3.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
